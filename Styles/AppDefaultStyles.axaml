<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">



<Style Selector="Button#PlaylistSelectorButton">
        <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
        <Setter Property="Background" Value="White"></Setter>
        <Setter Property="BorderBrush" Value="Black"></Setter>
        <Setter Property="BorderThickness" Value="5"></Setter>
        <Setter Property="CornerRadius" Value="0"></Setter>
        <Setter Property="Margin" Value="5,5,5,0"></Setter>
</Style> 

<Style Selector="Button#PlaylistSelectorButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Black"></Setter>
        <Setter Property="Foreground" Value="White"></Setter>
        <Setter Property="BorderBrush" Value="Black"></Setter>
        <Setter Property="BorderThickness" Value="5"></Setter>
</Style> 

<Style Selector="Button#PlaylistSelectorButton:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Black"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource PlaylistButtonPressedForeground}"></Setter>
        <Setter Property="BorderBrush" Value="Black"></Setter>
        <Setter Property="BorderThickness" Value="5"></Setter>
</Style> 



<Style Selector="TextBlock#PlaylistSelectorText">
        <Setter Property="FontSize" Value="20"></Setter>
        <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
        <Setter Property="MaxWidth" Value="450"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"></Setter>
</Style> 


<Style Selector="Border#ConsoleBorder">
        <Setter Property="Margin" Value="3"></Setter>
        <Setter Property="BorderThickness" Value="5"></Setter>
        <Setter Property="BorderBrush" Value="White"></Setter>
</Style>
<Style Selector="Border#ConsoleBorder">
        <Setter Property="Margin" Value="0,5,5,5"></Setter>
        <Setter Property="BorderThickness" Value="5"></Setter>
        <Setter Property="BorderBrush" Value="White"></Setter>
</Style>

<Style Selector="TextBlock#ConsoleTextBlock">
        <Setter Property="Padding" Value="5"></Setter>
        <Setter Property="Foreground" Value="White"></Setter>
        <Setter Property="Background" Value="Black"></Setter>
        <Setter Property="FontSize" Value="14"></Setter>
        <Setter Property="TextWrapping" Value="Wrap"></Setter>
</Style>
<Style Selector="TextBlock#ConsoleHeader">
        <Setter Property="Padding" Value="5"></Setter>
        <Setter Property="Foreground" Value="White"></Setter>
        <Setter Property="Background" Value="Black"></Setter>
        <Setter Property="FontSize" Value="25"></Setter>
        <Setter Property="TextAlignment" Value="Center"></Setter>
</Style>

<Style Selector="Border#PlaylistViewBorder">
        <Setter Property="Background" Value="White"></Setter>
        <Setter Property="Margin" Value="0,5,5,0"></Setter>
        <Setter Property="BorderThickness" Value="5"></Setter>
        <Setter Property="BorderBrush" Value="Black"></Setter>
</Style>
<Style Selector="TextBlock#PlaylistViewTitle">
        <Setter Property="Padding" Value="5"></Setter>
        <Setter Property="FontSize" Value="25"></Setter>
        <Setter Property="TextWrapping" Value="Wrap"></Setter>
</Style>
<Style Selector="Button.PlaylistViewButton">
        <Setter Property="HorizontalAlignment" Value="Center"></Setter>
        <Setter Property="FontSize" Value="16"></Setter>
        <Setter Property="Margin" Value="5,0,5,5"></Setter>
</Style>
<Style Selector="TextBlock.PlaylistViewProperties">
        <Setter Property="FontSize" Value="14"></Setter>
        <Setter Property="Margin" Value="5"></Setter>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"></Setter>
</Style>
<Style Selector="Image#PlaylistArt">
        <Setter Property="Width" Value="300"></Setter>
        <Setter Property="Margin" Value="10"></Setter>
        <Setter Property="VerticalAlignment" Value="Top"></Setter>
        <Setter Property="Effect">
                <Setter.Value>
                        <DropShadowEffect Color="Black"
                                        Opacity="0.6"
                                        BlurRadius="10"
                                        />
                </Setter.Value>
        </Setter>
</Style>


</Styles>