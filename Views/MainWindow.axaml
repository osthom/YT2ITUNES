<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YT2ITUNES.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="YT2ITUNES.Views.MainWindow"
        x:DataType="vm:NavigatorViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="YT2ITUNES"
        Height="750"
        Width="1250"
        >

    <Grid  RowDefinitions="50,*">
        <Grid  Background="{DynamicResource ResourceKey=PrimaryBackground}" Row="0" ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBlock Grid.Column="0" FontSize="40" Text="YT2ITUNES"/> 
            <Button Grid.Column="1" Command="{Binding NavigateToMainCommand}">Home</Button>
            <Button Grid.Column="2" Command="{Binding NavigateToSettingsCommand}">Settings</Button>
            <Button Grid.Column="3" Command="{Binding NavigateToAboutCommand}">About / Help </Button>
        </Grid>
        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}"/>
    </Grid>
</Window>
